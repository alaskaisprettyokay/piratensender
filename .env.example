PIRATENSENDER_WEB_PORT=8090
# PIRATENSENDER_LAN_IP=192.168.50.2
# PIRATENSENDER_MEDIAMTX_VERSION=v1.20.0

# Local venue nodes launched with ./start.sh allow DJ laptops on the LAN to
# open /broadcast. Leave this unset on public hosted demos unless publishing is
# protected by a firewall, auth layer, or trusted network.
# PIRATENSENDER_ALLOW_REMOTE_BROADCAST=1
